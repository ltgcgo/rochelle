{
	"name": "@ltgc/rochelle",
	"version": "0.3.5",
	"license": "LGPL-3.0-only",
	"exports": {
		"./textEncoding": "./dist/textEncoding.d.mts",
		"./textRead": "./dist/textRead.d.mts",
		"./binaryString": "./dist/binaryString.d.mts",
		"./bufferIO": "./dist/bufferIO.d.mts",
		"./bufferSegments": "./dist/bufferSegments.d.mts",
		"./dsvParse": "./dist/dsvParse.d.mts",
		"./integerHandler": "./dist/integerHandler.d.mts",
		"./nativeType": "./dist/nativeType.d.mts",
		"./numerics": "./dist/numerics.d.mts",
		"./splicer": "./dist/splicer.d.mts"
	},
	"publish": {
		"include": [
			"dist/**",
			"README.md"
		]
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 200,
		"indentWidth": 4,
		"semiColons": true,
		"exclude": [
			"*",
			"**/*"
		]
	},
	"lint": {
		"exclude": [
			"*"
		],
		"rules": {
			"tags": [],
			"include": [
				"constructor-super",
				"getter-return",
				"no-await-in-sync-fn",
				"no-cond-assign",
				"no-constant-condition",
				"no-dupe-args",
				"no-dupe-class-members",
				"no-dupe-else-if",
				"no-dupe-keys",
				"no-duplicate-case",
				"no-eval",
				"no-extra-boolean-cast",
				"no-extra-non-null-assertion",
				"no-invalid-regexp",
				"no-irregular-whitespace",
				"no-misused-new",
				"no-new-symbol",
				"no-node-globals",
				"no-non-null-asserted-optional-chain",
				"no-obj-calls",
				"no-process-global",
				"no-redeclare",
				"no-regex-spaces",
				"no-self-assign",
				"no-setter-return",
				"no-shadow-restricted-names",
				"no-sloppy-imports",
				"no-this-before-super",
				"no-throw-literal",
				"no-unused-labels",
				"no-unused-vars",
				"no-with",
				"require-yield",
				"use-isnan",
				"valid-typeof"
			]
		}
	},
	"nodeModulesDir": "none",
	"npmRegistry": "http://0.0.0.0:80/"
}